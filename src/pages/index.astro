---
import Layout from '../layouts/Layout.astro';
import StarTableSection from '../components/StarTableSection.astro';

// Famous repos the fork button cycles through. `size` tunes each mark to look the same weight.
const logos = [
	{ name: 'T3 Code', file: 't3code.png', size: '150%' },
	{ name: 'opencode', file: 'opencode.svg', size: '78%' },
	{ name: 'Ghostty', file: 'ghostty.svg', size: '92%' },
	{ name: 'Excalidraw', file: 'excalidraw.svg', size: '96%' },
];
---

<Layout>
	<main class="stage">
		<div class="content">
			<header class="hero">
				<h1 class="headline">
					<span class="line"><span class="loud">software</span> <span class="quiet">fork that</span></span>
					<span class="line"><span class="quiet">maintain</span> <span class="loud">itself</span></span>
				</h1>
			</header>

			<a class="fork-btn" href="#fork-section" aria-label={`fork ${logos[0].name}`}>
				<span class="segment segment-knob" aria-hidden="true">
					<span class="logo-reel">
						{logos.map((logo, i) => (
							<span
								class:list={['logo', { 'is-current': i === 0 }]}
								data-name={logo.name}
								style={`--logo: url(/logos/${logo.file}); --logo-size: ${logo.size}`}
							></span>
						))}
					</span>
				</span>
				<span class="segment segment-label">
					<span class="text">fork it</span>
				</span>
			</a>
		</div>

		<!-- Single bento table with both star fields -->
		<StarTableSection />
	</main>
</Layout>

<style>
	.stage {
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		min-height: 100svh;
		padding: 6vh 24px 18vh;
		gap: 6vh;
	}

	.content {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 100%;
	}

	.hero {
		--fs: clamp(28px, 4.85vw, 94px);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.42em;
		font-size: var(--fs);
	}

	.headline {
		margin: 0;
		font-size: var(--fs);
		font-weight: 500;
		line-height: 1.12;
		letter-spacing: -0.04em;
		text-align: center;
	}

	.line {
		display: block;
	}

	.loud {
		color: #f4f2ee;
	}

	.quiet {
		color: #6f6f6e;
	}

	/* --- Redesigned Fork Button --- */
	.fork-btn {
		--btn-h: clamp(38px, 3.6vw, 54px);
		--gap: clamp(3px, 0.3vw, 4.5px);
		--corner-r: calc(var(--btn-h) * 0.13);
		--pill-r: calc(var(--btn-h) / 2);
		--knob-w: calc(var(--btn-h) * 0.88);
		--label-w: calc(var(--btn-h) * 1.58);

		position: relative;
		display: inline-flex;
		align-items: center;
		gap: var(--gap);
		margin-top: clamp(40px, 6vw, 84px);
		text-decoration: none;
		cursor: pointer;
		user-select: none;
		-webkit-tap-highlight-color: transparent;
		transition: transform 0.2s cubic-bezier(0.2, 0, 0, 1), filter 0.2s ease;
	}

	.fork-btn:hover {
		filter: brightness(1.03);
		transform: translateY(-1px);
	}

	.fork-btn:active {
		transform: translateY(1px);
		filter: brightness(0.98);
	}

	.fork-btn:focus-visible {
		outline: 2px solid rgba(255, 255, 255, 0.5);
		outline-offset: 5px;
		border-radius: var(--pill-r);
	}

	.segment {
		position: relative;
		height: var(--btn-h);
		box-sizing: border-box;
		background-color: #ceccc8;
		background-image: linear-gradient(180deg, #d4d2ce 0%, #cbc9c5 45%, #c5c3bf 100%);
		box-shadow:
			/* Outer top rim highlight */
			0 -0.5px 0.5px 0 rgba(255, 255, 255, 0.75),
			/* Deep diffused inner shadow dipping from top edge */
			inset 0 calc(var(--btn-h) * 0.18) calc(var(--btn-h) * 0.22) calc(var(--btn-h) * -0.02) rgba(0, 0, 0, 0.52),
			/* Inset shadow from left edge */
			inset calc(var(--btn-h) * 0.08) 0 calc(var(--btn-h) * 0.15) -1px rgba(0, 0, 0, 0.35),
			/* Soft ambient depth */
			inset 0 calc(var(--btn-h) * 0.3) calc(var(--btn-h) * 0.38) calc(var(--btn-h) * -0.1) rgba(0, 0, 0, 0.2),
			/* Ambient bottom lift */
			inset 0 -1.5px 3px 0 rgba(255, 255, 255, 0.28),
			/* Soft drop shadow into dark background */
			0 3px 10px rgba(0, 0, 0, 0.45),
			0 1px 2px rgba(0, 0, 0, 0.3);
	}

	/* Bright, crisp top rim highlight that sits over the shadow */
	.segment::before {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		pointer-events: none;
		box-shadow:
			inset 0 1px 0.5px 0 rgba(255, 255, 255, 0.95),
			inset 0 0 0 0.5px rgba(255, 255, 255, 0.2);
	}

	.segment-knob {
		width: var(--knob-w);
		overflow: hidden;
		border-radius: var(--pill-r) var(--corner-r) var(--corner-r) var(--pill-r);
	}

	/* Like NumberFlow's digits: logos ride a strip and fade out at its edges, never overlapping */
	.logo-reel {
		position: absolute;
		inset: 0;
		-webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 26%, #000 74%, transparent 100%);
		mask-image: linear-gradient(180deg, transparent 0%, #000 26%, #000 74%, transparent 100%);
	}

	/* The repo you'd fork, pressed into the knob like the label text */
	.logo {
		position: absolute;
		inset: 0;
		margin: auto;
		width: calc(var(--btn-h) * 0.42);
		height: calc(var(--btn-h) * 0.42);
		background: #5c5b58;
		-webkit-mask: var(--logo) center / var(--logo-size) no-repeat;
		mask: var(--logo) center / var(--logo-size) no-repeat;
		filter: drop-shadow(0 1px 0 rgba(255, 255, 255, 0.55));
		opacity: 0;
	}

	.logo.is-current {
		opacity: 1;
	}

	.segment-label {
		width: var(--label-w);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: var(--corner-r) var(--pill-r) var(--pill-r) var(--corner-r);
	}

	.text {
		position: relative;
		z-index: 1;
		color: #5c5b58;
		font-family: 'Albert Sans', Inter, -apple-system, BlinkMacSystemFont, sans-serif;
		font-size: calc(var(--btn-h) * 0.35);
		font-weight: 400;
		letter-spacing: -0.022em;
		line-height: 1;
		white-space: nowrap;
	}

	@media (max-width: 560px) {
		.stage {
			padding: 7vh 20px 14vh;
		}

		.hero {
			gap: 0.3em;
		}

		.fork-btn {
			margin-top: clamp(36px, 10vw, 56px);
		}
	}
</style>

<script>
	// Roll the knob through famous repos, digit-style like NumberFlow: both marks ride
	// one strip, moving a full knob height together on the same spring, so the next one
	// arrives exactly as the last one leaves.
	const CYCLE_MS = 2400;
	const SPIN_MS = 750;
	const SPRING = 'linear(0, 0.006, 0.025 2.8%, 0.101 6.1%, 0.539 18.9%, 0.721 25.3%, 0.849 31.5%, 0.937 38.1%, 0.968 41.8%, 0.991 45.7%, 1.006 50.1%, 1.015 55%, 1.017 63.9%, 1.001)';

	for (const button of document.querySelectorAll<HTMLAnchorElement>('.fork-btn')) {
		const logos = [...button.querySelectorAll<HTMLElement>('.logo')];
		const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
		let index = 0;
		let paused = false;

		const next = () => {
			if (paused || document.hidden) return;
			const from = logos[index];
			index = (index + 1) % logos.length;
			const to = logos[index];
			from.classList.remove('is-current');
			to.classList.add('is-current');
			button.setAttribute('aria-label', `fork ${to.dataset.name}`);
			if (reduceMotion) return;
			const pitch = button.querySelector<HTMLElement>('.segment-knob')!.offsetHeight;
			const timing = { duration: SPIN_MS, easing: SPRING };
			from.animate([{ transform: 'translateY(0)', opacity: 1 }, { transform: `translateY(${-pitch}px)`, opacity: 1 }], timing);
			to.animate([{ transform: `translateY(${pitch}px)`, opacity: 1 }, { transform: 'translateY(0)', opacity: 1 }], timing);
		};

		// Hold still while someone's about to click.
		button.addEventListener('pointerenter', () => (paused = true));
		button.addEventListener('pointerleave', () => (paused = false));
		button.addEventListener('focus', () => (paused = true));
		button.addEventListener('blur', () => (paused = false));

		setInterval(next, CYCLE_MS);
	}
</script>
