---
// OrbitField.astro — row 2 visual. Your fork sits in the middle; every change you
// describe becomes a ring of stars orbiting it.
//
// Talks to the change picker in the same bento row through events:
//   patch:add    { text, el }  a change was added → new ring
//   patch:focus  { el }        the picker centred an item → light its ring
//   patch:select { el }        (sent) a ring was clicked → picker centres its item
// Items already marked [data-change][aria-pressed="true"] start as rings.
---

<div class="orbit-field">
	<canvas class="orbit-canvas" aria-hidden="true"></canvas>
	<div class="orbit-label orbit-count">
		<number-flow class="orbit-number"></number-flow>
		<span class="orbit-unit">change in PATCH.md</span>
	</div>
</div>

<style>
	.orbit-field { position:absolute; inset:0; }
	.orbit-canvas { position:absolute; inset:0; width:100%; height:100%; display:block; touch-action:pan-y; }
	.orbit-label {
		position:absolute; z-index:1; display:flex; align-items:baseline; gap:6px; pointer-events:none;
		font-family:Inter, -apple-system, BlinkMacSystemFont, sans-serif; font-size:12px; letter-spacing:0.01em;
		color:#6f6f6e; background:#141414; padding:5px 8px; border-radius:4px;
	}
	.orbit-count { right:12px; bottom:12px; }
	.orbit-number { color:#f4f2ee; font-size:20px; font-weight:500; letter-spacing:-0.02em; font-variant-numeric:tabular-nums; }
</style>

<script>
	import 'number-flow';
	import type NumberFlow from 'number-flow';
	import { starPath, makeRand, easeOut, makeSprite, drawSprite } from '../scripts/stars';

	const R_MIN = 44;            // first ring, px from your star
	const GAP = 32;              // ring spacing until they need to squeeze
	const GROW_MS = 900;
	type Ring = {
		r: number;
		born: number;
		spin: number;
		speed: number;
		flash: number;
		hover: number;
		line: HTMLElement | null;
		stars: { a: number; size: number; base: number }[];
	};

	for (const root of document.querySelectorAll<HTMLElement>('.orbit-field')) {
		const row = root.closest('.bento-row')!;
		const canvas = root.querySelector<HTMLCanvasElement>('.orbit-canvas')!;
		const unit = root.querySelector<HTMLElement>('.orbit-unit')!;
		const number = root.querySelector<NumberFlow>('.orbit-number')!;
		const ctx = canvas.getContext('2d')!;
		const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

		let w = 0, h = 0, dpr = 0;
		let sprite = makeSprite(1);
		let rings: Ring[] = [];
		let dust: { x: number; y: number; size: number; tw: number }[] = [];
		let hovered: Ring | null = null;
		let focused: HTMLElement | null = null;
		let last = performance.now();
		let visible = false;
		let frame = 0;
		const rand = makeRand(2027);

		const maxR = () => Math.min(w, h) / 2 - 40;

		// Every ring stays; they squeeze closer together once the panel fills up.
		const targetR = (i: number) => {
			const gap = rings.length > 1 ? Math.min(GAP, (maxR() - R_MIN) / (rings.length - 1)) : GAP;
			return R_MIN + i * gap;
		};

		const addChange = (line: HTMLElement | null, quiet = false) => {
			const i = rings.length;
			const finalR = Math.min(R_MIN + i * GAP, Math.max(R_MIN, maxR()));
			const count = Math.max(8, Math.round(finalR * 0.32));
			rings.push({
				r: reduceMotion ? finalR : 0,
				born: performance.now() - (reduceMotion ? GROW_MS : 0),
				spin: rand() * Math.PI * 2,
				speed: (i % 2 ? -1 : 1) * (0.18 + rand() * 0.1),
				flash: quiet ? 0 : 1,
				hover: 0,
				line,
				stars: Array.from({ length: count }, (_, k) => ({
					a: (k / count) * Math.PI * 2 + (rand() - 0.5) * 0.5,
					size: 2.6 + rand() * 1.8,
					base: 0.28 + rand() * 0.22,
				})),
			});
			unit.textContent = rings.length === 1 ? 'change in PATCH.md' : 'changes in PATCH.md';
			number.update(rings.length);
			wake();
		};

		const layout = () => {
			const rect = canvas.getBoundingClientRect();
			const nextDpr = Math.min(devicePixelRatio || 1, 2);
			if (nextDpr !== dpr) sprite = makeSprite(nextDpr);
			dpr = nextDpr;
			w = rect.width;
			h = rect.height;
			canvas.width = Math.round(w * dpr);
			canvas.height = Math.round(h * dpr);
			const r = makeRand(7);
			dust = Array.from({ length: Math.round((w * h) / 5200) }, () => ({
				x: r() * w, y: r() * h, size: 2.4 + r() * 1.6, tw: r() < 0.4 ? r() * Math.PI * 2 : -1,
			}));
		};

		const draw = (now: number) => {
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			ctx.clearRect(0, 0, w, h);
			const t = now / 1000;
			const cx = w / 2;
			const cy = h / 2;

			for (const d of dust) {
				const twinkle = d.tw >= 0 ? (Math.sin(t * 0.8 + d.tw) + 1) / 2 : 0;
				ctx.fillStyle = `rgba(210,210,210,${0.1 + twinkle * 0.2})`;
				starPath(ctx, d.x, d.y, d.size);
				ctx.fill();
			}

			rings.forEach((ring, i) => {
				const grow = easeOut(Math.min(1, Math.max(0, now - ring.born) / GROW_MS));
				const goal = targetR(i);
				ring.r = grow < 1 ? goal * grow : ring.r + (goal - ring.r) * 0.12;
				ring.flash *= 0.97;
				ring.hover += ((ring === hovered ? 1 : 0) - ring.hover) * 0.2;
				const lit = Math.max(ring.flash, ring.hover);

				ctx.strokeStyle = `rgba(244,242,238,${0.05 + lit * 0.12})`;
				ctx.lineWidth = 1;
				ctx.beginPath();
				ctx.arc(cx, cy, ring.r, 0, Math.PI * 2);
				ctx.stroke();

				for (const s of ring.stars) {
					const a = s.a + ring.spin;
					ctx.fillStyle = `rgba(244,242,238,${Math.min(1, (s.base + lit * 0.6) * grow)})`;
					starPath(ctx, cx + Math.cos(a) * ring.r, cy + Math.sin(a) * ring.r, s.size * (1 + lit * 0.4));
					ctx.fill();
				}
			});

			// Your fork: the same bright star you forked in row 1.
			drawSprite(ctx, sprite, cx, cy, 11 * (1 + Math.sin(t * 1.6) * 0.06));
		};

		const settled = () => rings.every((r, i) => r.flash < 0.01 && Math.abs(r.hover - (r === hovered ? 1 : 0)) < 0.01 && Math.abs(r.r - targetR(i)) < 0.2);

		const step = (now: number) => {
			const dt = Math.min(0.05, (now - last) / 1000);
			last = now;
			if (!reduceMotion) for (const r of rings) r.spin += r.speed * (R_MIN / Math.max(r.r, R_MIN)) * dt;
			draw(now);
			frame = visible && (!reduceMotion || !settled()) ? requestAnimationFrame(step) : 0;
		};

		const wake = () => {
			if (!frame && visible) { last = performance.now(); frame = requestAnimationFrame(step); }
		};

		const ringAt = (e: PointerEvent) => {
			const rect = canvas.getBoundingClientRect();
			const d = Math.hypot(e.clientX - rect.left - w / 2, e.clientY - rect.top - h / 2);
			let best: Ring | null = null;
			let bestD = 14;
			for (const r of rings) {
				if (Math.abs(d - r.r) < bestD) { bestD = Math.abs(d - r.r); best = r; }
			}
			return best;
		};

		const ringFor = (el: HTMLElement | null) => (el && rings.find((r) => r.line === el)) || null;

		const hover = (ring: Ring | null, quiet = false) => {
			if (ring === hovered) return;
			hovered?.line?.classList.remove('is-lit');
			hovered = ring;
			ring?.line?.classList.add('is-lit');
			wake();
		};

		new ResizeObserver(() => { layout(); draw(performance.now()); }).observe(canvas);
		new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; if (visible) wake(); }).observe(canvas);

		canvas.addEventListener('pointermove', (e) => {
			const ring = ringAt(e);
			canvas.style.cursor = ring ? 'pointer' : '';
			hover(ring ?? ringFor(focused), !ring);
		});
		canvas.addEventListener('pointerleave', () => hover(ringFor(focused), true));
		canvas.addEventListener('pointerdown', (e) => {
			const ring = ringAt(e);
			if (!ring) return;
			ring.flash = 1;
			if (ring.line) row.dispatchEvent(new CustomEvent('patch:select', { detail: { el: ring.line } }));
			wake();
		});

		row.querySelectorAll<HTMLElement>('[data-change][aria-pressed="true"]').forEach((el) => addChange(el, true));

		row.addEventListener('patch:add', (e) => {
			const { el } = (e as CustomEvent).detail;
			addChange(el);
			if (el === focused) { hovered = null; hover(ringFor(el), true); }
		});

		row.addEventListener('patch:focus', (e) => {
			focused = (e as CustomEvent).detail.el;
			hover(ringFor(focused), true);
		});

		number.update(rings.length);
	}
</script>
